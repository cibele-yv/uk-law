" AffectingEffectsExtent="S+A+M+E+A+S+A+F+F+E+C+T+E+D"><ukm:AffectedTitle>The Road Traffic Offenders (Northern Ireland) Order 1996</ukm:AffectedTitle><ukm:AffectedProvisions><ukm:Section Ref="article-52-2ZA" URI="http://www.legislation.gov.uk/id/nisi/1996/1320/article/52/2ZA" FoundRef="article-52">art. 52(2ZA)</ukm:Section></ukm:AffectedProvisions><ukm:AffectingTitle>Coroners and Justice Act 2009</ukm:AffectingTitle><ukm:AffectingProvisions><ukm:Section Ref="schedule-21" URI="http://www.legislation.gov.uk/id/ukpga/2009/25/schedule/21">Sch. 21 </ukm:Section><ukm:Section Ref="schedule-21-paragraph-92-9-b" URI="http://www.legislation.gov.uk/id/ukpga/2009/25/schedule/21/paragraph/92/9/b">para. 92(9)(b)</ukm:Section></ukm:AffectingProvisions><ukm:Savings><ukm:Section Ref="section-180" URI="http://www.legislation.gov.uk/id/ukpga/2009/25/section/180">s. 180</ukm:Section></ukm:Savings><ukm:CommencementAuthority><ukm:Section Ref="section-182-5" URI="http://www.legislation.gov.uk/id/ukpga/2009/25/section/182/5">s. 182(5)</ukm:Section></ukm:CommencementAuthority><ukm:InForceDates><ukm:InForce Applied="false" Prospective="true" Qualification=""/></ukm:InForceDates></ukm:UnappliedEffect></ukm:UnappliedEffects></ukm:SecondaryMetadata>
					

                    
									 
					
					
