				</ukm:Metadata><Secondary><Body DocumentURI="http://www.legislation.gov.uk/nisi/1995/2994/body" IdURI="http://www.legislation.gov.uk/id/nisi/1995/2994/body" NumberOfProvisions="118" RestrictStartDate="2020-12-31"><Part DocumentURI="http://www.legislation.gov.uk/nisi/1995/2994/part/II" IdURI="http://www.legislation.gov.uk/id/nisi/1995/2994/part/II" NumberOfProvisions="57" id="part-II" RestrictStartDate="2020-12-31"><Number>PART II</Number><Title>Principal Road Safety Provisions</Title><Pblock DocumentURI="http://www.legislation.gov.uk/nisi/1995/2994/part/II/crossheading/driving-offences" IdURI="http://www.legislation.gov.uk/id/nisi/1995/2994/part/II/crossheading/driving-offences" NumberOfProvisions="7" RestrictExtent="N.I." RestrictStartDate="2008-07-16" id="part-II-crossheading-driving-offences"><Title>Driving Offences</Title><P1group RestrictStartDate="2008-07-16"><Title><Addition ChangeId="d29p669" CommentaryRef="c21148121">Causing death or grievous bodily injury by driving: unlicensed, disqualified or uninsured driver</Addition></Title><P1 DocumentURI="http://www.legislation.gov.uk/nisi/1995/2994/article/12B" IdURI="http://www.legislation.gov.uk/id/nisi/1995/2994/article/12B" id="article-12B"><Pnumber><Addition ChangeId="d29p669" CommentaryRef="c21148121">12B</Addition></Pnumber><P1para><Text><Addition ChangeId="d29p669" CommentaryRef="c21148121">A person is guilty of an offence under this Article if he causes the death of, or grievous bodily injury to, another person by driving a motor vehicle on a road and, at the time when he is driving, the circumstances are such that he is committing an offence under—</Addition></Text><P3 DocumentURI="http://www.legislation.gov.uk/nisi/1995/2994/article/12B/a" IdURI="http://www.legislation.gov.uk/id/nisi/1995/2994/article/12B/a" id="article-12B-a"><Pnumber><Addition ChangeId="d29p669" CommentaryRef="c21148121">a</Addition></Pnumber><P3para><Text><Addition ChangeId="d29p669" CommentaryRef="c21148121">Article 3(1) of the Road Traffic (Northern Ireland) Order 1981 (driving otherwise than in accordance with a licence),</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/nisi/1995/2994/article/12B/b" IdURI="http://www.legislation.gov.uk/id/nisi/1995/2994/article/12B/b" id="article-12B-b"><Pnumber><Addition ChangeId="d29p669" CommentaryRef="c21148121">b</Addition></Pnumber><P3para><Text><Addition ChangeId="d29p669" CommentaryRef="c21148121">Article 90 of that Order (using motor vehicle while uninsured or unsecured against third party risks), or</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/nisi/1995/2994/article/12B/c" IdURI="http://www.legislation.gov.uk/id/nisi/1995/2994/article/12B/c" id="article-12B-c"><Pnumber><Addition ChangeId="d29p669" CommentaryRef="c21148121">c</Addition></Pnumber><P3para><Text><Addition ChangeId="d29p669" CommentaryRef="c21148121">Article 168A(1)(c) of that Order (driving while disqualified).</Addition></Text></P3para></P3></P1para></P1></P1group></Pblock></Part></Body></Secondary><Commentaries><Commentary id="c21148121" Type="F"><Para><Text><CitationSubRef id="c00089" URI="http://www.legislation.gov.uk/id/nisi/1995/2994/article/12B" SectionRef="article-12B">Art. 12B</CitationSubRef> inserted (16.7.2008) by <Citation URI="http://www.legislation.gov.uk/id/nisi/2008/1216" id="c00090" Class="NorthernIrelandOrderInCouncil" Year="2008" Number="1216" Title="Criminal Justice (Northern Ireland) Order 2008">Criminal Justice (Northern Ireland) Order 2008 (S.I. 2008/1216 (N.I. 1))</Citation>, <CitationSubRef id="c00091" URI="http://www.legislation.gov.uk/id/nisi/2008/1216/article/1/4" CitationRef="c00090" SectionRef="article-1-4">arts. 1(4)</CitationSubRef>, <CitationSubRef id="c00092" URI="http://www.legislation.gov.uk/id/nisi/2008/1216/article/53/1" CitationRef="c00090" SectionRef="article-53-1" Operative="true">53(1)</CitationSubRef> (with <CitationSubRef id="c00093" URI="http://www.legislation.gov.uk/id/nisi/2008/1216/article/53/3" CitationRef="c00090" SectionRef="article-53-3">art. 53(3)</CitationSubRef>); <Citation URI="http://www.legislation.gov.uk/id/nisr/2008/293" id="c00094" Class="NorthernIrelandStatutoryRule" Year="2008" Number="293">S.R. 2008/293</Citation>, <CitationSubRef id="c00095" URI="http://www.legislation.gov.uk/id/nisr/2008/293/article/2" CitationRef="c00094" SectionRef="article-2" Operative="true">art. 2</CitationSubRef>, <CitationSubRef id="c00096" URI="http://www.legislation.gov.uk/id/nisr/2008/293/schedule" CitationRef="c00094" SectionRef="schedule">Sch.</CitationSubRef></Text></Para></Commentary></Commentaries></Legislation>